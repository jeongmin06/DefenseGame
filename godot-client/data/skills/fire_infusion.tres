[gd_resource type="Resource" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/SkillDefinition.cs" id="SkillDefinition"]
[ext_resource type="Script" path="res://scripts/data/SkillEffectDefinition.cs" id="SkillEffectDefinition"]
[ext_resource type="Script" path="res://scripts/data/LocalizedText.cs" id="LocalizedText"]

[sub_resource type="Resource" id="description"]
script = ExtResource("LocalizedText")
Values = Dictionary[String, String]({"en": "Adds fire damage to hits and grants the FIRE tag.", "ko": "적중 피해에 화염 피해를 추가하고 화염 태그를 부여합니다."})

[sub_resource type="Resource" id="effect_0"]
script = ExtResource("SkillEffectDefinition")
Type = 2
FloatValue = 2

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("SkillEffectDefinition")
Type = 4
TagValue = "FIRE"

[resource]
script = ExtResource("SkillDefinition")
Id = "fire_infusion"
DisplayName = "화염 주입"
Description = SubResource("description")
Role = 1
Tags = Array[String]([])
RequiredAnyTags = Array[String](["HIT"])
RequiredAllTags = Array[String]([])
ForbiddenTags = Array[String]([])
LinkCost = 1
Effects = Array[ExtResource("SkillEffectDefinition")]([SubResource("effect_0"), SubResource("effect_1")])
