Role = 0
Tags = Array[String](["ATTACK", "PHYSICAL", "HIT"])
RequiredAnyTags = Array[String]([])
RequiredAllTags = Array[String]([])
ForbiddenTags = Array[String]([])
LinkCost = 0
BaseProjectileCount = 1
BasePierceCount = 0
BaseDamageMultiplier = 1
Effects = Array[ExtResource("SkillEffectDefinition")]([])
