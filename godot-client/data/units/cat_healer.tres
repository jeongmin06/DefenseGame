[sub_resource type="Resource" id="description"]
script = ExtResource("LocalizedText")
Values = Dictionary[String, String]({"en": "Deploy on grass tiles to heal the lowest-health ally in range.", "ko": "잔디 타일에 배치해 사거리 안에서 체력이 가장 낮은 아군을 치유합니다."})

[resource]
script = ExtResource("script")
