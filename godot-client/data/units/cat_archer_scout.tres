[gd_resource type="Resource" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/data/UnitDefinition.cs" id="script"]
[ext_resource type="Script" path="res://scripts/data/UnitVisualDefinition.cs" id="UnitVisualDefinition"]
[ext_resource type="Script" path="res://scripts/data/UnitAnimationDefinition.cs" id="UnitAnimationDefinition"]
[ext_resource type="Script" path="res://scripts/data/LocalizedText.cs" id="LocalizedText"]
[ext_resource type="PackedScene" path="res://scenes/tower.tscn" id="scene"]
[ext_resource type="Texture2D" path="res://assets/sprites/cat_archer_attack_sheet.png" id="sprite_sheet"]
[ext_resource type="PackedScene" path="res://scenes/arrow_projectile.tscn" id="projectile"]

[sub_resource type="Resource" id="description"]
script = ExtResource("LocalizedText")
Values = Dictionary[String, String]({"en": "A mobile scout archer. It temporarily shares the base archer artwork.", "ko": "기동성을 중시하는 정찰 궁수입니다. 현재는 기본 궁수 외형을 임시로 공유합니다."})

[sub_resource type="Resource" id="visual_idle"]
script = ExtResource("UnitAnimationDefinition")
StartFrame = 0
FrameCount = 1
FramesPerSecond = 1
Loop = true

[sub_resource type="Resource" id="visual_action"]
script = ExtResource("UnitAnimationDefinition")
StartFrame = 0
FrameCount = 8
FramesPerSecond = 12
Loop = false

[sub_resource type="Resource" id="visual"]
script = ExtResource("UnitVisualDefinition")
SpriteSheet = ExtResource("sprite_sheet")
FrameSize = Vector2i(443, 443)
SpritePosition = Vector2(0, -45)
SpriteScale = Vector2(0.22, 0.22)
SourceFacesLeft = false
UseChromaKey = true
Idle = SubResource("visual_idle")
Action = SubResource("visual_action")

[resource]
script = ExtResource("script")
Id = "cat_archer_scout"
