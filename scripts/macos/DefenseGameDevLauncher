#!/bin/zsh

set -eu

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPOSITORY_PATH_FILE="$APP_ROOT/Resources/repository-path"

if [[ ! -f "$REPOSITORY_PATH_FILE" ]]; then
  osascript -e 'display alert "DefenseGame Dev" message "저장소 경로 정보가 없습니다. 설치 스크립트를 다시 실행하세요." as critical'
  exit 1
fi

REPOSITORY_PATH="$(<"$REPOSITORY_PATH_FILE")"
RUNNER="$REPOSITORY_PATH/scripts/run-dev.sh"

if [[ ! -x "$RUNNER" ]]; then
  osascript -e 'display alert "DefenseGame Dev" message "실행 스크립트를 찾을 수 없습니다. 저장소를 이동했다면 설치 스크립트를 다시 실행하세요." as critical'
  exit 1
fi

SELECTED_ACTION="$(osascript <<'APPLESCRIPT'
set actionItems to {"Godot 에디터 열기", "게임 바로 실행", "검토 영상 생성", "검토 영상 생성 후 비공개 업로드"}
set selectedItems to choose from list actionItems with title "DefenseGame Dev" with prompt "실행할 작업을 선택하세요." default items {item 1 of actionItems} OK button name "실행" cancel button name "취소"
if selectedItems is false then
  return ""
end if
return item 1 of selectedItems
APPLESCRIPT
)"

case "$SELECTED_ACTION" in
  "Godot 에디터 열기")
    RUNNER_ARGUMENT="--editor"
    ;;
  "게임 바로 실행")
    RUNNER_ARGUMENT="--play"
    ;;
  "검토 영상 생성")
    RUNNER_ARGUMENT="--capture"
    ;;
  "검토 영상 생성 후 비공개 업로드")
    RUNNER_ARGUMENT="--capture-upload"
    ;;
  "")
    exit 0
    ;;
  *)
    osascript -e 'display alert "DefenseGame Dev" message "알 수 없는 작업이 선택되었습니다." as critical'
    exit 1
    ;;
esac

osascript - "$RUNNER" "$RUNNER_ARGUMENT" <<'APPLESCRIPT'
on run argv
  set runnerPath to item 1 of argv
  set runnerArgument to item 2 of argv
  tell application "Terminal"
    activate
    do script "exec " & quoted form of runnerPath & " " & quoted form of runnerArgument
  end tell
end run
APPLESCRIPT
